DISCORD_TOKEN=dein_bot_token_hier
GUILD_ID=deine_server_id_hier

# JSON-Format: [{"roleName":"Private","prefix":"PVT"},{"roleName":"Corporal","prefix":"CPL"}]
ROLE_PREFIXES=[{"roleName":"Private","prefix":"PVT"}]

# Optional: true = existierende Präfixe bei Rollenwechsel ersetzen, false = nur setzen wenn kein Präfix existiert
REPLACE_EXISTING_PREFIX=true

# Optional für den Generator:
# PREFIX_FALLBACK_STRATEGY=initials oder first3
# INCLUDE_MANAGED_ROLES=true/false
PREFIX_FALLBACK_STRATEGY=initials
INCLUDE_MANAGED_ROLES=false
